// NppPrintPreview の版の情報（プラグイン管理は DLL の FileVersion と一覧の version が一致することを求める）
// 版を変えるときは NppPrintPreview.cpp の PLUGIN_VERSION も合わせる
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "denkikaiden"
            VALUE "FileDescription", "Print preview for Notepad++"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NppPrintPreview"
            VALUE "LegalCopyright", "(C) 2026 denkikaiden"
            VALUE "OriginalFilename", "NppPrintPreview.dll"
            VALUE "ProductName", "NppPrintPreview"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
